rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function existing() { return resource.data; }
    function incoming() { return request.resource.data; }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // Role checks
    function isAuthority() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'authority';
    }

    // Users Collection
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.role in ['citizen', 'authority'] &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.createdAt is string;
    }

    match /users/{userId} {
      allow get: if isAuthenticated() && isValidId(userId);
      allow list: if false; // No blanket reads for users.
      
      allow create: if isAuthenticated() && isValidId(userId) && userId == request.auth.uid && 
                    isValidUser(incoming()) && incoming().role == 'citizen';
                    
      allow update: if isAuthenticated() && isValidId(userId) && userId == request.auth.uid &&
                    isValidUser(incoming()) &&
                    incoming().role == existing().role &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'neighborhoodId', 'tier', 'points']);
    }

    // Reports Collection
    function isValidReport(data) {
      return data.keys().hasAll(['userId', 'category', 'status', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.category in ["pothole", "garbage", "sewage", "lighting", "other"] &&
             data.status in ["pending", "acknowledged", "in_progress", "resolved"] &&
             data.createdAt is timestamp;
    }

    match /reports/{reportId} {
      // Community reporting is public data by design, so blanket read is permitted.
      allow get: if isAuthenticated() && isValidId(reportId);
      allow list: if isAuthenticated(); 
      
      allow create: if isAuthenticated() && isValidId(reportId) && isValidReport(incoming()) && 
                    incoming().status == 'pending' && 
                    // To prevent Denial of Wallet we check string limits
                    (!('description' in incoming()) || (incoming().description is string && incoming().description.size() <= 3000));
                    
      allow update: if isAuthenticated() && isValidId(reportId) && (
        // Action: Authority updates status
        (isAuthority() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'resolvedImageUrl', 'priority', 'updatedAt'])) ||
        // Action: Citizen supports report
        (incoming().diff(existing()).affectedKeys().hasOnly(['supportCount', 'updatedAt']) && 
         incoming().supportCount == existing().supportCount + 1 &&
         existsAfter(/databases/$(database)/documents/reports/$(reportId)/supports/$(request.auth.uid))) ||
        // Action: Citizen rates solution
        (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'updatedAt']))
      );
    }

    // Supports Subcollection
    match /reports/{reportId}/supports/{supportId} {
      allow get: if isAuthenticated() && isValidId(reportId) && isValidId(supportId);
      allow list: if isAuthenticated() && isValidId(reportId);
      allow create: if isAuthenticated() && isValidId(reportId) && isValidId(supportId) &&
                    supportId == request.auth.uid && 
                    incoming().keys().hasAll(['userId', 'reportId', 'createdAt']) &&
                    incoming().userId == request.auth.uid &&
                    incoming().reportId == reportId &&
                    incoming().createdAt is timestamp;
    }
  }
}
